# Backend port
PORT=8000
# Frontend port for development
VITE_DEV_PORT=3000

# Express jwt secret
SECRET= # Generate your own using python.secrets.token_hex(16)

# MongoDB connection string used by a host run (npm run dev).
# With the bundled Docker MongoDB running, mongodb://localhost:27017/muvico
# works. The app container ignores this value and always uses the bundled
# MongoDB at mongodb://mongo:27017/muvico, set directly in compose.yaml.
MONGODB_URI=mongodb://localhost:27017/muvico
# MongoDB connection string for e2e tests. Required when running Playwright e2e.
# With the bundled Docker MongoDB running, mongodb://localhost:27017/test works.
TEST_MONGODB_URI=mongodb://localhost:27017/test

# S3 style object storage.
# Leave these empty to use the bundled local Garage instance in Docker
# (npm run start). It listens on localhost:3900 and is created with the
# defaults shown in the comments below.
#
# Endpoint the browser uses to follow presigned URLs.
# Bundled Garage default: http://localhost:3900
PUBLIC_S3_ENDPOINT=
# Endpoint the backend uses for server side calls (uploads, deletes, metadata).
# Only needed when the storage is reachable under a different hostname from the
# server than from the browser, which is the case in Docker.
# Bundled Garage default: http://garage:3900
# Leave empty to reuse PUBLIC_S3_ENDPOINT for both.
PRIVATE_S3_ENDPOINT=
# object storage bucket. Bundled Garage default: muvico
BUCKET_NAME=
# object storage region. Bundled Garage default: garage
BUCKET_REGION=
# object storage access key. Must start with GK for Garage.
ACCESS_KEY=
# object storage secret access key
SECRET_ACCESS_KEY=
# Origins allowed to read media from the bundled local Garage bucket.
# Comma separated, defaults to * since it only ever runs on localhost.
# Has no effect on a remote bucket, where CORS is set by the provider.
S3_CORS_ALLOWED_ORIGINS=

# Project firebase keys
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Backend firebase service account key as base64 encoded json
FIREBASE_SERVICE_KEY=

# Project google keys for Drive integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
