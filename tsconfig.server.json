{
  "compilerOptions": {
    /* tsc IS the server's builder here, unlike tsconfig.json where Vite owns
       emission -- there is no bundler in front of the server, so tsc both
       checks and compiles it to server-dist/. */
    "outDir": "server-dist",
    "rootDir": "src",

    "skipLibCheck": true,

    "target": "ES2022",
    "lib": ["ES2022"],

    /* Classic CommonJS output: Node runs server-dist/server/index.js directly,
       no loader flags. Source uses import/export like the rest of the repo;
       tsc lowers it to require/module.exports. */
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    "allowJs": false,
    "checkJs": false,

    "strict": true,
    /* Same carve-out as tsconfig.json, same reason: strict would break the
       many existing `catch (error) { error.message }` sites here too. */
    "useUnknownInCatchVariables": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node", "jest"]
  },
  "include": ["src/server/**/*.ts", "src/constants.d.ts"],
  "exclude": ["node_modules", "server-dist", "coverage", "playwright-report"]
}
